# ---- Database ----
# Matches the postgres service in docker-compose.yml (host port 15432).
# at a different (e.g. managed/cloud) Postgres instance.
DATABASE_URL="postgresql://ghg_admin:ghg_dev_password@localhost:15432/ghg_platform?schema=public"

# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Auth ----
# Generate a real secret before anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Object storage (audit-evidence attachments) ----
# For local dev, these point at the MinIO container in docker-compose.yml.
# For production, swap in real AWS S3 / DigitalOcean Spaces credentials and remove S3_ENDPOINT
# (or keep it, pointed at your Spaces/MinIO endpoint) — see attachments.service.ts.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ghg-attachments
S3_ACCESS_KEY_ID=ghg_minio_admin
S3_SECRET_ACCESS_KEY=ghg_minio_dev_password
# Leave blank to store attachments in a private bucket and generate signed URLs on read instead
# (recommended for production — see the fallback note in attachments.service.ts).
S3_PUBLIC_URL_BASE=http://localhost:9000/ghg-attachments

# ---- Background jobs (wired in a later phase — see architecture doc Section 1 tech stack table) ----
REDIS_URL=redis://localhost:6379

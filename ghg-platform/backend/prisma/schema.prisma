// Prisma schema — runnable translation of the SQL DDL in GHG_Platform_Architecture.md
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL to generate the real DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  admin
  data_entry
  management
  verifier // external auditor / verifier: read-only access to data, evidence, audit log and exports
}

enum GhgScope {
  scope_1
  scope_2
  scope_3
}

enum Scope1Subcategory {
  stationary_combustion
  mobile_combustion
  fugitive_emissions
}

enum Scope2Method {
  location_based
  market_based
}

enum BoundaryApproach {
  operational_control
  financial_control
  equity_share
}

// IPCC Assessment Report whose 100-year Global Warming Potentials convert CH4 and N2O into CO2e.
enum GwpSet {
  AR5
  AR6
}

// How an entry's emissions were worked out (GHG Protocol Scope 3 Standard, calculation methods).
enum CalculationMethod {
  activity_based    // physical quantity x emission factor (litres, kWh, km, kg ...)
  spend_based       // money spent x emission factor per currency unit (e.g. kg CO2e / USD)
  supplier_specific // emissions reported by the supplier, entered directly (kg or t CO2e)
}

enum ReportingStatus {
  draft
  submitted
  approved
  locked
}

enum AuditAction {
  create
  update
  delete
  submit
  approve
  export
  login
}

// ---------- Tenancy & Access ----------

model Organization {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  country         String?
  defaultCurrency String?  @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  facilities       Facility[]
  users            User[]
  reportingPeriods ReportingPeriod[]
  emissionFactors  EmissionFactor[]
  activityData     ActivityData[]
  relevanceScreens Scope3RelevanceScreen[]
  auditLogs        AuditLog[]
  reductionTargets     ReductionTarget[]
  reductionInitiatives ReductionInitiative[]
  creditLots           CreditLot[]
  creditRetirements    CreditRetirement[]
  removalRecords       RemovalRecord[]
  tzCarbonProjects     TzCarbonProject[]
  claimAttestations    ClaimAttestation[]

  @@map("organizations")
}

model Facility {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  address        String?
  country        String?
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityData ActivityData[]
  restrictedUsers User[]      @relation("RestrictedFacility")

  @@map("facilities")
}

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  email                  String
  passwordHash           String    @map("password_hash")
  fullName               String    @map("full_name")
  role                   UserRole  @default(data_entry)
  restrictedFacilityId   String?   @map("restricted_facility_id") @db.Uuid
  isActive               Boolean   @default(true) @map("is_active")
  lastLoginAt            DateTime? @map("last_login_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restrictedFacility   Facility?   @relation("RestrictedFacility", fields: [restrictedFacilityId], references: [id])

  enteredActivityData  ActivityData[] @relation("EnteredBy")
  updatedActivityData  ActivityData[] @relation("UpdatedBy")
  createdEmissionFactors EmissionFactor[]
  uploadedAttachments  Attachment[]
  auditLogs            AuditLog[]
  submittedPeriods     ReportingPeriod[] @relation("SubmittedBy")
  approvedPeriods      ReportingPeriod[] @relation("ApprovedBy")
  returnedPeriods      ReportingPeriod[] @relation("ReturnedBy")
  assessedScreens      Scope3RelevanceScreen[]

  @@unique([organizationId, email])
  @@map("users")
}

// ---------- Reference Data ----------

model GhgCategory {
  id                Int      @id @default(autoincrement())
  scope             GhgScope
  scope3CategoryNo  Int?     @map("scope3_category_no")
  name              String
  scope1Subcategory Scope1Subcategory? @map("scope1_subcategory")
  description       String?

  emissionFactors  EmissionFactor[]
  activityData     ActivityData[]
  relevanceScreens Scope3RelevanceScreen[]
  initiatives      ReductionInitiative[]

  @@unique([scope, scope3CategoryNo])
  @@map("ghg_categories")
}

model EmissionFactor {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // null = global/system default
  categoryId     Int      @map("category_id")
  factorName     String   @map("factor_name")
  value          Decimal  @db.Decimal(14, 6)
  unit           String
  // Optional split by gas, in kg of each gas per unit (same unit as `value`). When all three are
  // present, CO2e is calculated from the gases with the reporting period's GWP set (AR5 or AR6)
  // and results are reported per gas; otherwise `value` (already in CO2e) is used as published.
  co2PerUnit     Decimal? @map("co2_per_unit") @db.Decimal(18, 9)
  ch4PerUnit     Decimal? @map("ch4_per_unit") @db.Decimal(18, 9)
  n2oPerUnit     Decimal? @map("n2o_per_unit") @db.Decimal(18, 9)
  validYear      Int      @map("valid_year")
  source         String
  notes          String?
  isDefault      Boolean  @default(true) @map("is_default")
  isReviewed     Boolean  @default(false) @map("is_reviewed")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     GhgCategory   @relation(fields: [categoryId], references: [id])
  createdByUser User?        @relation(fields: [createdBy], references: [id])
  activityData ActivityData[]

  @@unique([organizationId, categoryId, factorName, validYear])
  @@index([categoryId, validYear])
  @@map("emission_factors")
}

// ---------- Reporting Periods, Activity Data & Evidence ----------

model ReportingPeriod {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String            @map("organization_id") @db.Uuid
  year                        Int
  boundaryApproach            BoundaryApproach  @default(operational_control) @map("boundary_approach")
  isBaseYear                  Boolean           @default(false) @map("is_base_year")
  recalculationThresholdPct   Decimal           @default(5.00) @map("recalculation_threshold_pct") @db.Decimal(5, 2)
  gwpSet                      GwpSet            @default(AR6) @map("gwp_set")
  staffFte                    Decimal?          @map("staff_fte") @db.Decimal(6, 1)
  status                      ReportingStatus   @default(draft)
  submittedBy                 String?           @map("submitted_by") @db.Uuid
  submittedAt                 DateTime?         @map("submitted_at")
  approvedBy                  String?           @map("approved_by") @db.Uuid
  approvedAt                  DateTime?         @map("approved_at")
  // Set when an approver sends a submitted period back to draft for corrections
  returnReason                String?           @map("return_reason")
  returnedBy                  String?           @map("returned_by") @db.Uuid
  returnedAt                  DateTime?         @map("returned_at")
  createdAt                   DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submitter    User?        @relation("SubmittedBy", fields: [submittedBy], references: [id])
  approver     User?        @relation("ApprovedBy", fields: [approvedBy], references: [id])
  returner     User?        @relation("ReturnedBy", fields: [returnedBy], references: [id])

  activityData     ActivityData[]
  relevanceScreens Scope3RelevanceScreen[]

  @@unique([organizationId, year])
  @@map("reporting_periods")
}

model ActivityData {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  facilityId                String   @map("facility_id") @db.Uuid
  reportingPeriodId         String   @map("reporting_period_id") @db.Uuid
  categoryId                Int      @map("category_id")
  scope2Method               Scope2Method? @map("scope2_method")

  sourceName                 String   @map("source_name")
  detail                     String?
  fuelOrMaterialType         String?  @map("fuel_or_material_type")

  quantity                   Decimal  @db.Decimal(16, 4)
  unit                       String

  emissionFactorId           String?  @map("emission_factor_id") @db.Uuid
  emissionFactorValueUsed    Decimal  @map("emission_factor_value_used") @db.Decimal(14, 6)
  emissionFactorUnitUsed     String   @map("emission_factor_unit_used")
  emissionFactorSourceUsed   String   @map("emission_factor_source_used")

  sourceActivityDataId       String?  @map("source_activity_data_id") @db.Uuid
  derivationNote              String? @map("derivation_note")

  emissionsKgco2e             Decimal @map("emissions_kgco2e") @db.Decimal(16, 4)
  emissionsTco2e               Decimal @map("emissions_tco2e") @db.Decimal(16, 6) // computed in service layer on save

  // Scope 2 dual reporting (GHG Protocol Scope 2 Guidance). The fields above hold the
  // location-based result for Scope 2 rows; these hold the market-based result.
  marketEmissionFactorId       String?  @map("market_emission_factor_id") @db.Uuid
  marketFactorValueUsed        Decimal? @map("market_factor_value_used") @db.Decimal(14, 6)
  marketFactorUnitUsed         String?  @map("market_factor_unit_used")
  marketFactorSourceUsed       String?  @map("market_factor_source_used")
  marketEmissionsKgco2e        Decimal? @map("market_emissions_kgco2e") @db.Decimal(16, 4)
  marketEmissionsTco2e         Decimal? @map("market_emissions_tco2e") @db.Decimal(16, 6)
  marketBasisNote              String?  @map("market_basis_note")

  // Data quality score, 1 = best (metered / supplier-verified) to 5 = weakest (rough estimate).
  dataQualityScore             Int?     @map("data_quality_score")

  calculationMethod            CalculationMethod @default(activity_based) @map("calculation_method")
  // Mass of each gas (kg), when the emission factor is split by gas. Null = factor given in CO2e only.
  co2Kg                        Decimal? @map("co2_kg") @db.Decimal(18, 6)
  ch4Kg                        Decimal? @map("ch4_kg") @db.Decimal(18, 6)
  n2oKg                        Decimal? @map("n2o_kg") @db.Decimal(18, 6)
  gwpSetUsed                   GwpSet?  @map("gwp_set_used")

  notes                         String?
  status                         ReportingStatus @default(draft)

  enteredBy                       String   @map("entered_by") @db.Uuid
  enteredAt                        DateTime @default(now()) @map("entered_at")
  updatedBy                         String?  @map("updated_by") @db.Uuid
  updatedAt                          DateTime @default(now()) @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility         Facility         @relation(fields: [facilityId], references: [id])
  reportingPeriod  ReportingPeriod  @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  category         GhgCategory      @relation(fields: [categoryId], references: [id])
  emissionFactor   EmissionFactor?  @relation(fields: [emissionFactorId], references: [id])
  enteredByUser    User             @relation("EnteredBy", fields: [enteredBy], references: [id])
  updatedByUser    User?            @relation("UpdatedBy", fields: [updatedBy], references: [id])

  // self-reference for derived Scope 3 rows (WTT / T&D loss -> source Scope 1/2 row)
  // onDelete: Cascade — deleting a Scope 1/2 source row also deletes its automatic WTT / T&D row.
  sourceActivityData ActivityData?  @relation("Derivation", fields: [sourceActivityDataId], references: [id], onDelete: Cascade)
  derivedRows        ActivityData[] @relation("Derivation")

  attachments Attachment[]

  // At most one automatic (derived) row per source row and category.
  @@unique([sourceActivityDataId, categoryId])
  @@index([reportingPeriodId])
  @@index([categoryId])
  @@index([facilityId])
  @@map("activity_data")
}

model Scope3RelevanceScreen {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  reportingPeriodId   String   @map("reporting_period_id") @db.Uuid
  categoryId          Int      @map("category_id")
  isIncluded          Boolean  @default(false) @map("is_included")
  relevanceAssessment String   @map("relevance_assessment")
  assessedBy          String?  @map("assessed_by") @db.Uuid
  assessedAt          DateTime @default(now()) @map("assessed_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  category        GhgCategory     @relation(fields: [categoryId], references: [id])
  assessor        User?           @relation(fields: [assessedBy], references: [id])

  @@unique([reportingPeriodId, categoryId])
  @@map("scope3_relevance_screen")
}

model Attachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityDataId String   @map("activity_data_id") @db.Uuid
  fileName       String   @map("file_name")
  fileUrl        String   @map("file_url")
  fileType       String?  @map("file_type")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  activityData ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploadedBy], references: [id])

  @@map("attachments")
}

// ---------- Governance ----------

model AuditLog {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String?     @map("entity_id") @db.Uuid
  oldValue       Json?       @map("old_value")
  newValue       Json?       @map("new_value")
  ipAddress      String?     @map("ip_address")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------- Reduce (Phase 2): targets and reduction initiatives ----------

enum TargetCoverage {
  scope_1_2 // Scope 1 + Scope 2 (location-based)
  scope_3
  all_scopes
}

enum TargetType {
  absolute  // cut total tCO2e by X% from the base year
  intensity // cut tCO2e per employee (FTE) by X% from the base year
}

enum InitiativeStatus {
  idea
  planned
  in_progress
  completed
  cancelled
}

model ReductionTarget {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String
  coverage        TargetCoverage
  targetType      TargetType     @default(absolute) @map("target_type")
  baseYear        Int            @map("base_year")
  // Base-year emissions (tCO2e) for the covered scopes; for intensity targets, tCO2e per FTE.
  // Taken from the base-year reporting period when the target is created, or entered by hand.
  baseYearValue   Decimal        @map("base_year_value") @db.Decimal(16, 6)
  targetYear      Int            @map("target_year")
  reductionPct    Decimal        @map("reduction_pct") @db.Decimal(5, 2)
  notes           String?
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("reduction_targets")
}

model ReductionInitiative {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  name                  String
  description           String?
  scope                 GhgScope
  categoryId            Int?             @map("category_id")
  status                InitiativeStatus @default(idea)
  startYear             Int              @map("start_year")
  lifetimeYears         Int              @map("lifetime_years")
  // Expected reduction per year once running (tCO2e / year)
  annualReductionTco2e  Decimal          @map("annual_reduction_tco2e") @db.Decimal(14, 4)
  // Up-front investment and the change in yearly running costs (negative = yearly savings)
  capex                 Decimal          @default(0) @db.Decimal(16, 2)
  annualOpexChange      Decimal          @default(0) @map("annual_opex_change") @db.Decimal(16, 2)
  currency              String           @default("USD")
  discountRatePct       Decimal          @default(10) @map("discount_rate_pct") @db.Decimal(5, 2)
  owner                 String?
  notes                 String?
  createdBy             String?          @map("created_by") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     GhgCategory? @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
  @@map("reduction_initiatives")
}

// ---------- Offset (Phase 3a): carbon credits, removals, Tanzanian projects, claims ----------
// Credits and removals are kept OUTSIDE the emissions inventory: gross emissions are never reduced
// by them. They are reported next to the inventory and used only for claims (VCMI).

enum CreditRegistry {
  verra
  gold_standard
  plan_vivo
  acr
  car
  article_6_4
  tanzania_national
  other
}

enum CreditKind {
  avoidance_reduction     // e.g. cookstoves, renewable energy, avoided deforestation (REDD+)
  removal_nature          // e.g. afforestation, soil carbon
  removal_technological   // e.g. biochar, direct air capture
}

model CreditLot {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String         @map("organization_id") @db.Uuid
  projectName               String         @map("project_name")
  registry                  CreditRegistry
  registryProjectId         String?        @map("registry_project_id")
  methodology               String?
  kind                      CreditKind     @default(avoidance_reduction)
  country                   String?
  vintageYear               Int            @map("vintage_year")
  serialRange               String?        @map("serial_range")
  quantityTco2e             Decimal        @map("quantity_tco2e") @db.Decimal(14, 4)
  // Quality: ICVCM Core Carbon Principles label, Article 6 authorisation / corresponding adjustment
  ccpLabelled               Boolean        @default(false) @map("ccp_labelled")
  article6Authorized        Boolean        @default(false) @map("article6_authorized")
  correspondingAdjustment   Boolean        @default(false) @map("corresponding_adjustment")
  // Due-diligence checklist against the 10 Core Carbon Principles: { principleKey: true|false|null }
  dueDiligence              Json?          @map("due_diligence")
  purchaseDate              DateTime?      @map("purchase_date")
  pricePerTonne             Decimal?       @map("price_per_tonne") @db.Decimal(14, 2)
  currency                  String?
  tzProjectId               String?        @map("tz_project_id") @db.Uuid
  notes                     String?
  createdBy                 String?        @map("created_by") @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tzProject    TzCarbonProject?   @relation(fields: [tzProjectId], references: [id], onDelete: SetNull)
  retirements  CreditRetirement[]

  @@index([organizationId])
  @@map("credit_lots")
}

model CreditRetirement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  lotId           String   @map("lot_id") @db.Uuid
  quantityTco2e   Decimal  @map("quantity_tco2e") @db.Decimal(14, 4)
  retiredOn       DateTime @map("retired_on")
  // The reporting year whose claim these credits support
  claimYear       Int      @map("claim_year")
  beneficiary     String?
  // Registry retirement reference / serial numbers retired; the certificate is kept as evidence
  retirementReference String @map("retirement_reference")
  evidenceUrl     String?  @map("evidence_url")
  notes           String?
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lot          CreditLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([organizationId, claimYear])
  @@map("credit_retirements")
}

enum RemovalType {
  nature
  technological
}

// GHG Protocol Land Sector and Removals Standard: removals reported separately from the inventory,
// with storage monitoring and reversal risk.
model RemovalRecord {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  projectName        String      @map("project_name")
  removalType        RemovalType @map("removal_type")
  method             String      // e.g. agroforestry, reforestation, soil carbon, biochar
  location           String?
  reportingYear      Int         @map("reporting_year")
  removedTco2e       Decimal     @map("removed_tco2e") @db.Decimal(14, 4)
  reversalsTco2e     Decimal     @default(0) @map("reversals_tco2e") @db.Decimal(14, 4)
  storageYears       Int?        @map("storage_years")
  reversalRiskPct    Decimal?    @map("reversal_risk_pct") @db.Decimal(5, 2)
  monitoringPlan     String?     @map("monitoring_plan")
  lastMonitoredOn    DateTime?   @map("last_monitored_on")
  inValueChain       Boolean     @default(true) @map("in_value_chain")
  evidenceUrl        String?     @map("evidence_url")
  notes              String?
  createdBy          String?     @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportingYear])
  @@map("removal_records")
}

enum TzRegistrationStatus {
  concept
  submitted
  under_review
  approved
  registered
  rejected
}

enum Article6Status {
  not_applicable
  requested
  authorized
  refused
}

// Tanzania carbon trading regulations (2022, amended 2023): project registration, NDC alignment,
// benefit sharing, and Article 6 authorisation for credits transferred abroad.
model TzCarbonProject {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  name                  String
  projectType           String               @map("project_type")
  isReddPlus            Boolean              @default(false) @map("is_redd_plus")
  region                String?
  district              String?
  proponent             String?
  registrationStatus    TzRegistrationStatus @default(concept) @map("registration_status")
  registrationNumber    String?              @map("registration_number")
  ndcAlignment          String?              @map("ndc_alignment")
  // Benefit sharing, % of gross revenue as agreed / required for this project
  communitySharePct     Decimal?             @map("community_share_pct") @db.Decimal(5, 2)
  localGovernmentSharePct Decimal?           @map("local_government_share_pct") @db.Decimal(5, 2)
  nationalSharePct      Decimal?             @map("national_share_pct") @db.Decimal(5, 2)
  otherSharePct         Decimal?             @map("other_share_pct") @db.Decimal(5, 2)
  benefitSharingNote    String?              @map("benefit_sharing_note")
  article6Status        Article6Status       @default(not_applicable) @map("article6_status")
  expectedAnnualCredits Decimal?             @map("expected_annual_credits") @db.Decimal(14, 2)
  standard              CreditRegistry?
  notes                 String?
  createdBy             String?              @map("created_by") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditLots   CreditLot[]

  @@index([organizationId])
  @@map("tz_carbon_projects")
}

// The organisation's statements needed for a VCMI claim that the platform cannot see in its own data.
model ClaimAttestation {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  claimYear               Int      @map("claim_year")
  limitedAssurance        Boolean  @default(false) @map("limited_assurance")
  assuranceProvider       String?  @map("assurance_provider")
  inventoryPublished      Boolean  @default(false) @map("inventory_published")
  publicDisclosureUrl     String?  @map("public_disclosure_url")
  advocacyParisAligned    Boolean  @default(false) @map("advocacy_paris_aligned")
  governanceInPlace       Boolean  @default(false) @map("governance_in_place")
  updatedBy               String?  @map("updated_by") @db.Uuid
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, claimYear])
  @@map("claim_attestations")
}

